# LinkedIn Session Cookies (Required for fast Voyager API mode)
# You can find these by logging into LinkedIn, opening Developer Tools -> Application -> Cookies
LI_AT="your_li_at_cookie_value_here"
JSESSIONID="your_jsessionid_cookie_value_here"

# LinkedIn Credentials (Required for Playwright stealth auto-login mode)
# This is used to log in automatically via a real browser — the most stable approach.
LINKEDIN_EMAIL="your_linkedin_email@example.com"
LINKEDIN_PASSWORD="your_linkedin_password"
